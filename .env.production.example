APP_NAME="Rangrez Restaurant"
APP_ENV=production
APP_KEY=base64:replace_with_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://menu.example.com
APP_PORT=8080
APP_TIMEZONE=Asia/Tashkent

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_DATABASE=rangrez
DOCKER_DB_USERNAME=rangrez
DOCKER_DB_PASSWORD=replace_with_strong_database_password
DOCKER_DB_ROOT_PASSWORD=replace_with_different_root_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password
